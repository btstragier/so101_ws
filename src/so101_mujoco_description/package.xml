<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_mujoco_description</name>
  <version>0.0.0</version>
  <description>MuJoCo (MJCF) model of the SO-101 arm, converted from so101_description</description>
  <maintainer email="btstragier@gmail.com">bjorn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>so101_description</build_depend>
  <!-- meshes are referenced from here at runtime -->
  <exec_depend>so101_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
